// Volumetric cloud layer (cumulus / storm deck / low fog deck), lightning channel.
#pragma once
#include "/NYC/Common.ush"

float NycRemap(float v, float a, float b, float c, float d) { return c + (v - a) / max(b - a, 1e-4) * (d - c); }

// Returns albedo; extinction is per metre and emissive is luminance per metre.
float3 NycCloudMain(
	float3 WP, Texture3D Vol, SamplerState VolS, Texture2D NoiseTex, SamplerState NoiseS,
	float Coverage, float StormAmt, float LowDeck, float DeckBase, float Drift,
	float3 OvercastColor, float3 GlowColor, float Flash, float3 FlashPosition,
	out float3 Extinction, out float3 Emis)
{
	float3 P = WP * 0.01;                     // metres
	float h = P.z;
	float2 wind = float2(0.35, 0.94);
	float2 pxy = P.xy - wind * Drift;
	float ext = 0.0;
	float shade = 1.0;
	float bottomness = 0.0;

	// ---- cumulus field that closes into a deck as coverage rises
	float base = lerp(1500.0, 850.0, StormAmt);
	float thick = lerp(850.0, 1500.0, StormAmt);
	float hn = (h - base) / thick;
	if (hn > -0.05 && hn < 1.0 && Coverage > 0.01)
	{
		float4 w = NoiseTex.SampleLevel(NoiseS, pxy / 21000.0, 0);
		float4 w2 = NoiseTex.SampleLevel(NoiseS, pxy / 7400.0 + 0.37, 0);
		float cov = saturate(Coverage * 1.12 + ((w.r - 0.5) * 0.9 + (w2.g - 0.5) * 0.35) * saturate(1.15 - Coverage));
		float profile = saturate(hn * 9.0) * (1.0 - smoothstep(0.42 + 0.4 * cov, 1.0, hn));
		float4 s = Vol.SampleLevel(VolS, float3(pxy / 4700.0, h / 3100.0), 0);
		float shape = saturate(NycRemap(s.r, (s.g * 0.625 + s.b * 0.25 + s.a * 0.125) - 1.0, 1.0, 0.0, 1.0));
		shape = lerp(shape, s.r, 0.45);
		float d = saturate(NycRemap(shape * profile, 1.0 - cov, 1.0, 0.0, 1.0));
		if (d > 0.0)
		{
			float4 e = Vol.SampleLevel(VolS, float3((pxy - wind * Drift * 0.4) / 950.0, h / 950.0), 0);
			float er = e.g * 0.55 + e.b * 0.3 + e.a * 0.15;
			er = lerp(er, 1.0 - er, saturate(hn * 3.0));
			d = saturate(NycRemap(d, er * 0.36, 1.0, 0.0, 1.0));
		}
		float deck = smoothstep(0.82, 1.0, Coverage) * profile;
		if (deck > 0.0)
		{
			float4 m = Vol.SampleLevel(VolS, float3(pxy / 2300.0, h / 1500.0), 0);
			d = max(d, deck * saturate(0.2 + 1.15 * (m.r - 0.25) + (w2.r - 0.5) * 0.6));
		}
		ext = d * lerp(0.028, 0.052, StormAmt);
		bottomness = saturate(1.0 - hn * 1.6);
		// storm bases are mottled: darker lobes and brighter gaps
		shade = lerp(1.0, 0.55 + 0.9 * saturate((w2.b - 0.3) * 1.5), StormAmt);
	}

	// ---- low deck: mist that takes the tops off the towers
	float deckExt = 0.0;
	if (LowDeck > 0.01 && h > DeckBase - 120.0 && h < DeckBase + 520.0)
	{
		float4 a = Vol.SampleLevel(VolS, float3((pxy + Drift * 0.2) / 780.0, h / 520.0), 0);
		float4 b = Vol.SampleLevel(VolS, float3((P.xy - wind * Drift * 1.7) / 260.0, h / 210.0), 0);
		float ragged = (a.r - 0.5) * 150.0 + (b.g - 0.5) * 60.0;
		float hd = h - (DeckBase + ragged);
		float prof = smoothstep(-25.0, 95.0, hd) * (1.0 - smoothstep(260.0, 420.0, hd));
		deckExt = LowDeck * prof * saturate(0.45 + (a.g - 0.45) * 1.3 + (b.r - 0.5) * 0.7) * 0.017;
	}

	float total = ext + deckExt;
	if (total <= 0.0)
	{
		Extinction = 0;
		Emis = 0;
		return float3(0.9, 0.9, 0.9);
	}

	// emissive fill: diffuse daylight inside an overcast, city light from below at night, lightning
	float3 fill = OvercastColor * shade * lerp(0.62, 1.12, saturate(1.0 - bottomness));
	float citynear = exp(-length(P.xy - float2(0.0, -300.0)) / 9000.0);
	float3 glow = GlowColor * (0.78 + 0.75 * citynear) * (0.4 + 0.9 * bottomness + (deckExt > 0.0 ? 0.55 : 0.0));
	Emis = ext * (fill + glow) + deckExt * (OvercastColor * 0.9 + glow * 1.15);
	if (Flash > 0.001)
	{
		float3 FP = FlashPosition * 0.01;
		float2 dxy = P.xy - FP.xy;
		float dist2 = dot(dxy, dxy) + (h - base) * (h - base) * 0.6;
		float4 lobes = Vol.SampleLevel(VolS, float3(P.xy / 2600.0, h / 1900.0), 0);
		float reach = exp(-dist2 / (1700.0 * 1700.0)) + 0.1 * exp(-dist2 / (6000.0 * 6000.0));
		Emis += total * Flash * reach * (0.25 + 1.8 * lobes.r * lobes.g) * float3(0.72, 0.76, 1.0) * 46.0;
	}
	Extinction = total;
	return lerp(float3(0.97, 0.97, 0.98), float3(0.78, 0.8, 0.84), StormAmt);
}

float3 NycBoltMain(float2 UV, float4 VCol, float Envelope)
{
	float across = 1.0 - abs(UV.x - 0.5) * 2.0;
	float core = pow(saturate(across), 2.2);
	return float3(0.72, 0.76, 1.0) * (core * 90000.0 + across * 5000.0) * VCol.r * Envelope;
}
