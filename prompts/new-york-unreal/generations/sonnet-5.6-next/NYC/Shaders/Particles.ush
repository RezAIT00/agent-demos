// Surfaces for the Niagara particles.  Light levels are physical (cd/m2), taken from the weather
// controller, so sparks, dust and spray sit correctly at noon and at midnight.
#pragma once
#include "/NYC/Common.ush"

float4 NycNSpark(float2 UV, float4 PCol, float Nits)
{
	float2 d = UV - 0.5;
	// a hot filament along the direction of flight
	float core = saturate(1.0 - abs(d.x) * 7.0) * saturate(1.0 - abs(d.y) * 2.15);
	float halo = saturate(1.0 - length(d * float2(2.4, 1.4)) * 1.45);
	float a = saturate(core * 1.3 + halo * halo * 0.35) * PCol.a;
	float3 c = PCol.rgb * Nits * (core * 2.2 + halo * halo * 0.5);
	return float4(c * PCol.a, a);
}

float4 NycNEmber(float2 UV, float4 PCol, float Nits)
{
	float r = length(UV - 0.5) * 2.0;
	float core = saturate(1.0 - r * 1.7);
	float halo = saturate(1.0 - r);
	return float4(PCol.rgb * Nits * (core * 2.0 + halo * halo * 0.45) * PCol.a, saturate(core + halo * 0.3) * PCol.a);
}

float4 NycNDust(float2 UV, float4 PCol, float3 WP, float SceneDepth, float PixelDepth, float3 SkyColor, float3 SunColor, float SunLux,
	Texture3D Vol, SamplerState VolS)
{
	float2 d = (UV - 0.5) * 2.0;
	float r = length(d);
	float n = Vol.SampleLevel(VolS, WP * 0.00135 + float3(UV * 0.35, 0), 0).r;
	float n2 = Vol.SampleLevel(VolS, WP * 0.0047, 0).g;
	float shape = saturate((1.0 - r) * 1.8 - (1.0 - n) * 0.95 - (1.0 - n2) * 0.3 + 0.28);
	float soft = saturate((SceneDepth - PixelDepth) / 90.0) * saturate((PixelDepth - 60.0) / 200.0);
	// fake roundness: the upper side of each billow catches more sky and sun
	float up = saturate(0.62 - d.y * 0.42);
	float3 L = PCol.rgb * (SkyColor * (0.65 + 0.55 * up) + SunColor * SunLux * 0.31831 * (0.13 + 0.24 * up) + 0.25);
	float a = shape * soft * PCol.a;
	return float4(L * a, a);
}

float4 NycNFlame(float2 UV, float4 PCol, float3 WP, float SceneDepth, float PixelDepth, float Nits, float Time, Texture3D Vol, SamplerState VolS)
{
	float2 d = (UV - 0.5) * 2.0;
	float n = Vol.SampleLevel(VolS, WP * 0.0042 - float3(0, 0, Time * 1.9), 0).r;
	float shape = saturate((1.0 - length(d * float2(1.25, 0.95))) * 2.2 - (1.0 - n) * 1.35 + 0.18);
	float soft = saturate((SceneDepth - PixelDepth) / 40.0);
	float heat = saturate(shape * 1.25);
	float3 c = lerp(float3(0.85, 0.11, 0.008), float3(1.0, 0.42, 0.045), saturate(heat * 2.0));
	c = lerp(c, float3(1.0, 0.78, 0.36), saturate(heat * 2.0 - 1.05));
	float a = shape * soft * PCol.a;
	return float4(c * PCol.rgb * Nits * a * (0.45 + heat), a * 0.28);
}

float4 NycNWater(float2 UV, float4 PCol, float SceneDepth, float PixelDepth, float3 SkyColor, float3 SunColor, float SunLux)
{
	float2 d = (UV - 0.5) * 2.0;
	float shape = saturate(1.0 - length(d * float2(1.9, 1.05)));
	float soft = saturate((SceneDepth - PixelDepth) / 30.0);
	float glint = saturate(1.0 - length((d - float2(0.0, -0.3)) * float2(4.0, 3.0)));
	float3 L = PCol.rgb * (SkyColor * 1.35 + SunColor * SunLux * 0.024 + 0.3) + glint * (SkyColor * 1.3 + SunColor * SunLux * 0.05);
	float a = saturate(shape * 1.3) * soft * PCol.a;
	return float4(L * a, a * 0.8);
}

float3 NycNChip(float3 WP, float4 PCol, Texture3D Vol, SamplerState VolS)
{
	float n = Vol.SampleLevel(VolS, WP * 0.011, 0).g;
	return PCol.rgb * (0.65 + 0.75 * n);
}
