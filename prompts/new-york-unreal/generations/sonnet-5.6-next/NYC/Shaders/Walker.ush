// Pedestrian skinning and shading.
//
// Every walker owns one row of BoneTex, rewritten each frame by UNYCWalkerComponent:
//   texels   0..49   this frame's skinning transforms, two per bone (quaternion, translation)
//   texels  50..99   last frame's, expressed in this frame's root space (for motion vectors)
//   texels 100..111  colours and clothing parameters (see NycRow* below)
#pragma once
#include "/NYC/Common.ush"

#define NYCW_PREV 50
#define NYCW_COAT 100    // rgb, a = umbrella open amount
#define NYCW_LEGS 101    // rgb, a = coat construction style
#define NYCW_ACCENT 102  // rgb, a = shirt-and-tie V
#define NYCW_BAG 103     // rgb, a = body scale (height / 176)
#define NYCW_SHOE 104    // rgb, a = coat hem height
#define NYCW_SKIN 105    // rgb, a = height of the bottom of the lapel V
#define NYCW_HAIR 106    // rgb, a = per walker seed 0..1
#define NYCW_HEAD 107    // xyz = head reference point at rest, a = head scale
#define NYCW_UMB 108     // rgb, a = 1 female

float3 NycQRot(float4 q, float3 v)
{
	float3 t = 2.0 * cross(q.xyz, v);
	return v + q.w * t + cross(q.xyz, t);
}

void NycBones(float2 UVa, float2 UVb, out int3 I, out float3 W)
{
	uint packed = (uint)(UVa.x + 0.5);
	I = int3(packed & 31, (packed >> 5) & 31, (packed >> 10) & 31);
	W = float3(UVb.x, UVb.y, saturate(1.0 - UVb.x - UVb.y));
}

// an umbrella furls by drawing its ribs in toward the shaft
float3 NycFurl(float3 P, float2 UVa, float4 VCol, float Open)
{
	uint pf = (uint)(UVa.y + 0.5);
	if ((pf & 31) != 15 || VCol.g < 0.97 || Open > 0.999) return P;
	float o = Open * Open * (3.0 - 2.0 * Open);
	float r = length(P.xy);
	float k = lerp(0.13, 1.0, o);
	float drop = (1.0 - o) * r * 0.78;
	return float3(P.xy * k, P.z - drop);
}

float3 NycSkinPoint(Texture2D Tex, float2 UVa, float2 UVb, int row, int base, float3 rest)
{
	int3 I; float3 W;
	NycBones(UVa, UVb, I, W);
	float3 p = 0;
	for (int k = 0; k < 3; ++k)
	{
		if (W[k] <= 0.0005) continue;
		int c = base + I[k] * 2;
		float4 q = Tex.Load(int3(c, row, 0));
		float3 t = Tex.Load(int3(c + 1, row, 0)).xyz;
		p += W[k] * (NycQRot(q, rest) + t);
	}
	return p;
}

// world position offset in instance space; base selects this frame or the previous one
float3 NycWalkerOffset(Texture2D Tex, float2 UVa, float2 UVb, float4 VCol, float Row, int base, float3 Rest)
{
	int row = (int)(Row + 0.5);
	float open = Tex.Load(int3(NYCW_COAT, row, 0)).a;
	float3 shaped = NycFurl(Rest, UVa, VCol, open);
	return NycSkinPoint(Tex, UVa, UVb, row, base, shaped) - Rest;
}

float3 NycWalkerNormal(Texture2D Tex, float2 UVa, float2 UVb, float Row, float3 N)
{
	int row = (int)(Row + 0.5);
	int3 I; float3 W;
	NycBones(UVa, UVb, I, W);
	float3 n = 0;
	for (int k = 0; k < 3; ++k)
	{
		if (W[k] <= 0.0005) continue;
		n += W[k] * NycQRot(Tex.Load(int3(I[k] * 2, row, 0)), N);
	}
	return n;
}

// ---------------------------------------------------------------------------- shading
float NycwHash(float3 p)
{
	p = frac(p * 0.3183099 + 0.1);
	p *= 17.0;
	return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float NycwNoise(float3 x)
{
	float3 i = floor(x), f = frac(x);
	f = f * f * (3.0 - 2.0 * f);
	return lerp(lerp(lerp(NycwHash(i), NycwHash(i + float3(1, 0, 0)), f.x), lerp(NycwHash(i + float3(0, 1, 0)), NycwHash(i + float3(1, 1, 0)), f.x), f.y),
		lerp(lerp(NycwHash(i + float3(0, 0, 1)), NycwHash(i + float3(1, 0, 1)), f.x), lerp(NycwHash(i + float3(0, 1, 1)), NycwHash(i + float3(1, 1, 1)), f.x), f.y), f.z);
}

// anti-aliased line of half width w around d = 0, fp = pixel footprint in the same units
float NycwLine(float d, float w, float fp)
{
	float aa = max(fp, 0.001);
	return saturate((w + aa * 0.5 - abs(d)) / aa) * saturate(w * 2.0 / aa);
}

float NycwInside(float d, float fp) { return saturate(0.5 - d / max(fp, 0.001)); }

float NycSrgbToLinear(float c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }

float3 NycWalkerShade(
	Texture2D Tex, float Row, float2 UVa, float4 VCol, float3 Rest, float3 RestN, float3 SkinN, float3 WP, float3 CamPos,
	float Wetness, float Rain, float SnowFall, float Night,
	out float Roughness, out float3 Normal, out float Specular, out float Metallic, out float3 Emissive, out float AO)
{
	int row = (int)(Row + 0.5);
	uint pf = (uint)(UVa.y + 0.5);
	int part = (int)(pf & 31);
	int fabric = (int)(pf >> 5);
	float4 cCoat = Tex.Load(int3(NYCW_COAT, row, 0));
	float4 cLegs = Tex.Load(int3(NYCW_LEGS, row, 0));
	float4 cAcc = Tex.Load(int3(NYCW_ACCENT, row, 0));
	float4 cBag = Tex.Load(int3(NYCW_BAG, row, 0));
	float4 cShoe = Tex.Load(int3(NYCW_SHOE, row, 0));
	float4 cSkin = Tex.Load(int3(NYCW_SKIN, row, 0));
	float4 cHair = Tex.Load(int3(NYCW_HAIR, row, 0));
	float4 cHead = Tex.Load(int3(NYCW_HEAD, row, 0));
	float4 cUmb = Tex.Load(int3(NYCW_UMB, row, 0));

	float s = max(cBag.a, 0.5);
	float seed = cHair.a;
	float female = cUmb.a;
	int style = (int)(cLegs.a + 0.5);
	AO = saturate(NycSrgbToLinear(VCol.r));
	float detailMask = NycSrgbToLinear(VCol.g);

	float3 N = normalize(SkinN);
	float3 rn = normalize(RestN);
	float3 dpdx = ddx(WP), dpdy = ddy(WP);
	float fp = max(length(fwidth(Rest)) * 0.75, 0.02);   // cm per pixel on the surface
	float3 V = normalize(CamPos - WP);
	float graze = pow(saturate(1.0 - abs(dot(N, V))), 3.0);

	float3 base = float3(0.05, 0.05, 0.05);
	float rough = 0.85, spec = 0.35, metal = 0.0, height = 0.0, bump = 1.0, porosity = 0.5, fuzz = 0.0;
	Emissive = 0;

	// ---- what this surface is made of ----------------------------------------------------------
	if (part == 0) { base = cCoat.rgb; }
	else if (part == 1) { base = cCoat.rgb * 0.45; }
	else if (part == 2) { base = cLegs.rgb; }
	else if (part == 3) { base = cShoe.rgb; }
	else if (part == 4) { base = cShoe.r > 0.3 ? float3(0.55, 0.53, 0.5) : cShoe.rgb * 0.35 + 0.006; }
	else if (part == 5 || part == 12) { base = cSkin.rgb; }
	else if (part == 6) { base = cHair.rgb; }
	else if (part == 7) { base = cAcc.rgb; }
	else if (part == 8) { base = cAcc.rgb; }
	else if (part == 9) { base = cBag.rgb; }
	else if (part == 10) { base = seed > 0.7 ? float3(0.045, 0.022, 0.011) : float3(0.011, 0.01, 0.01); }
	else if (part == 11) { base = float3(0.02, 0.02, 0.022); }
	else if (part == 13) { base = lerp(float3(0.11, 0.075, 0.048), float3(0.36, 0.29, 0.2), NycwNoise(Rest * 1.7)); }
	else if (part == 14) { base = float3(0.58, 0.6, 0.64); }
	else base = cBag.rgb;

	// ---- fabrics -------------------------------------------------------------------------------
	float near1 = saturate(1.4 - fp / 0.22);      // millimetre detail fades with distance
	float near2 = saturate(1.4 - fp / 0.9);       // centimetre detail
	if (fabric == 0)        // wool felt
	{
		float melange = NycwNoise(Rest * 2.3) - 0.5, coarse = NycwNoise(Rest * 0.55) - 0.5;
		base *= 1.0 + near1 * 0.34 * melange + near2 * 0.12 * coarse;
		base += near1 * saturate(NycwNoise(Rest * 5.1) - 0.78) * 0.05 * (0.4 + base);
		rough = 0.93; spec = 0.22; height = near1 * melange * 0.05 + coarse * near2 * 0.07; fuzz = 0.55; porosity = 0.8;
	}
	else if (fabric == 1)   // quilted nylon
	{
		float crinkle = NycwNoise(Rest * float3(0.8, 0.8, 1.3)) - 0.5;
		rough = 0.47; spec = 0.45; height = near2 * (crinkle * 0.16 + (NycwNoise(Rest * 2.4) - 0.5) * 0.04); porosity = 0.15; fuzz = 0.12;
		base *= 1.0 + 0.05 * crinkle;
	}
	else if (fabric == 2)   // leather
	{
		float grain = NycwNoise(Rest * 3.6) - 0.5, wear = NycwNoise(Rest * 0.32) - 0.5;
		rough = 0.42 + 0.16 * wear + 0.08 * grain; spec = 0.42; height = near1 * grain * 0.035 + near2 * wear * 0.1; porosity = 0.12;
		base *= 1.0 + 0.22 * wear;
	}
	else if (fabric == 3)   // denim
	{
		float twill = sin((Rest.z * 0.8 + (Rest.x + Rest.y) * 0.6) * 13.0);
		float slub = NycwNoise(Rest * float3(2.0, 2.0, 7.0)) - 0.5;
		base *= 1.0 + near1 * (0.12 * twill + 0.3 * slub);
		// washed paler on the thighs and knees
		float worn = saturate(rn.x * 1.2 - 0.2) * exp(-pow((Rest.z - 62.0 * s) / (24.0 * s), 2.0));
		if (part == 2) base = lerp(base, base * 1.75 + 0.012, worn * 0.7);
		rough = 0.88; spec = 0.25; height = near1 * (twill * 0.022 + slub * 0.03); porosity = 0.75; fuzz = 0.3;
	}
	else if (fabric == 4)   // knit
	{
		float across = (part == 7) ? atan2(Rest.y, Rest.x - cHead.x) * 10.0 * s : Rest.y + Rest.x * 0.35;
		float rib = sin(across * 6.2831853 / 0.95);
		float stitch = sin(Rest.z * 6.2831853 / 0.55 + abs(frac(across / 0.95) - 0.5) * 5.0);
		float k = saturate(1.5 - fp / 0.28);
		base *= 1.0 + k * (0.14 * rib + 0.07 * stitch) + near2 * 0.14 * (NycwNoise(Rest * 1.3) - 0.5);
		height = k * (rib * 0.09 + stitch * 0.028);
		rough = 0.96; spec = 0.18; porosity = 0.9; fuzz = 0.7;
	}
	else if (fabric == 5)   // canvas, cotton drill
	{
		float weave = sin(Rest.z * 18.0) * sin((Rest.y + Rest.x) * 18.0);
		float mott = NycwNoise(Rest * 0.7) - 0.5;
		base *= 1.0 + near1 * 0.08 * weave + near2 * 0.12 * mott;
		rough = 0.82; spec = 0.28; height = near1 * weave * 0.018 + near2 * mott * 0.05; porosity = 0.55; fuzz = 0.2;
	}
	else if (fabric == 6)   // smooth nylon
	{
		rough = 0.36; spec = 0.45; porosity = 0.08;
		base *= 1.0 + 0.08 * (NycwNoise(Rest * 1.1) - 0.5);
	}
	else if (fabric == 7)   // fur
	{
		float tuft = NycwNoise(Rest * 2.2) - 0.5;
		base *= 1.0 + near1 * 0.9 * tuft;
		rough = 1.0; spec = 0.12; height = near1 * tuft * 0.3; fuzz = 1.0; porosity = 0.9;
	}
	else if (fabric == 9)   // polished: shafts, buckles, phone
	{
		rough = 0.24; spec = 0.5; metal = part == 15 ? 0.55 : 0.0; porosity = 0.0;
	}
	else { rough = 0.62; spec = 0.35; porosity = 0.2; }

	// ---- how the coat is made: closures, lapels, pockets, seams --------------------------------
	if (part == 0 && rn.x > 0.25 && Rest.x > 0.0 && abs(Rest.y) < 14.5 * s && Rest.z < 153.0 * s)
	{
		float y = Rest.y, z = Rest.z / s;
		float front = smoothstep(0.25, 0.55, rn.x);
		float hem = cShoe.a / s;
		float vb = cSkin.a / s;
		float line_ = 0.0, shade = 0.0;
		bool zipped = style == 3 || style == 4 || style == 5;
		bool lapelled = style == 0 || style == 1 || style == 2 || style == 7;
		float vHalf = lapelled ? saturate((z - vb) / (148.0 - vb)) * (cAcc.a > 0.5 ? 6.4 : 4.4) : 0.0;
		if (!zipped && z > hem && z < (lapelled ? vb : 146.0))
		{
			line_ = max(line_, NycwLine(y + 0.45, 0.16, fp));
			shade += NycwLine(y + 0.75, 0.3, fp) * 0.25;
		}
		if (zipped && z > hem + 4.0 && z < 150.0)
		{
			float zipper = NycwLine(y - 0.3, 0.42, fp);
			float teeth = 0.5 + 0.5 * sin(z * 6.2831853 / 0.42) * saturate(1.0 - fp / 0.18);
			base = lerp(base, float3(0.16, 0.16, 0.165) * (0.55 + teeth), zipper * 0.85);
			metal = lerp(metal, 0.7, zipper * 0.7);
			rough = lerp(rough, 0.38, zipper);
			line_ = max(line_, NycwLine(abs(y - 0.3) - 1.25, 0.09, fp));
			// pull tab
			float tab = NycwInside(max(abs(y - 0.3) - 0.55, abs(z - 141.0) - 1.4), fp);
			base = lerp(base, float3(0.2, 0.2, 0.21), tab);
			metal = lerp(metal, 0.8, tab);
		}
		// buttons
		if (style == 0 || style == 1 || style == 2 || style == 6)
		{
			bool twin = style == 1 || style == 2;
			float pitch = style == 6 ? 8.0 : 9.6;
			float top = style == 6 ? 140.0 : vb - 1.5;
			float k = round((top - z) / pitch);
			if (k >= 0.0 && k < (twin ? 4.0 : 5.0) && top - k * pitch > hem + 12.0)
			{
				float by = twin ? (abs(y) - 5.2) : (y - 1.25);
				float d = length(float2(by, z - (top - k * pitch))) - (style == 6 ? 0.78 : 1.12);
				float b = NycwInside(d, fp);
				float rim = NycwLine(d, 0.16, fp);
				float3 bc = style == 6 ? float3(0.35, 0.23, 0.09) : (style == 1 && seed > 0.6 ? float3(0.32, 0.22, 0.08) : float3(0.016, 0.014, 0.013));
				base = lerp(base, bc, b);
				base *= 1.0 - rim * 0.45;
				rough = lerp(rough, 0.28, b);
				spec = lerp(spec, 0.5, b);
				metal = lerp(metal, (style == 6 || (style == 1 && seed > 0.6)) ? 0.85 : 0.0, b);
				height += b * 0.2;
			}
		}
		// lapels and what shows between them
		if (lapelled && z > vb - 0.4)
		{
			float inner = NycwInside(abs(y) - vHalf, fp);
			float3 knit = lerp(cAcc.rgb * 0.8 + 0.008, float3(0.045, 0.047, 0.052), step(0.55, seed));
			float3 under = knit * (1.0 + 0.12 * sin(y * 7.0) * near1);
			float underRough = 0.95;
			if (cAcc.a > 0.5)
			{
				float shirtHue = frac(seed * 7.31);
				under = shirtHue < 0.62 ? float3(0.62, 0.63, 0.66) : float3(0.35, 0.47, 0.66);
				underRough = 0.72;
				// the shirt collar and the tie
				float collar = NycwLine(abs(y) - (z - 143.0) * 0.55 - 1.2, 0.22, fp) * step(143.0, z);
				under *= 1.0 - collar * 0.35;
				float tieHalf = 0.9 + saturate((143.0 - z) / 16.0) * 0.85;
				float tie = NycwInside(abs(y) - (z > 145.2 ? 1.35 : tieHalf), fp) * step(vb, z);
				float knot = NycwLine(z - 145.1, 0.2, fp);
				under = lerp(under, cAcc.rgb * (1.0 + 0.2 * sin((y + z) * 8.0) * near1) * (1.0 - 0.4 * knot), tie);
			}
			base = lerp(base, under, inner);
			rough = lerp(rough, underRough, inner);
			// lapel flap with a notch
			float outerHalf = vHalf + 4.1 * saturate((z - vb) / 9.0) - 1.7 * NycwInside(abs(z - 141.5) - 1.0, fp);
			float flap = NycwInside(abs(y) - outerHalf, fp) * (1.0 - inner);
			base *= 1.0 + 0.07 * flap;
			line_ = max(line_, NycwLine(abs(y) - outerHalf, 0.2, fp) * step(abs(y), 12.0));
			shade += NycwLine(abs(y) - outerHalf - 0.45, 0.38, fp) * 0.35;
			line_ = max(line_, NycwLine(abs(y) - vHalf, 0.16, fp));
			line_ = max(line_, NycwLine(z - 141.5 - (abs(y) - vHalf - 1.0) * 0.5, 0.13, fp) * flap);
			height += flap * 0.18 - inner * 0.3;
		}
		// pockets
		if (style == 0 || style == 1 || style == 2 || style == 7)
		{
			float zp = style == 1 ? 98.0 : 93.0;
			float ay = abs(y);
			if (ay > 7.5 && ay < 14.2)
			{
				float d = z - zp - (ay - 11.0) * 0.18;
				line_ = max(line_, NycwLine(d, 0.2, fp));
				line_ = max(line_, NycwLine(d + 2.3, 0.14, fp) * (style == 7 ? 0.0 : 1.0));
				shade += NycwLine(d - 0.55, 0.45, fp) * 0.3;
			}
		}
		else if (style == 3 || style == 4 || style == 5)
		{
			float ay = abs(y);
			float d = ay - 10.2 - (112.0 - z) * 0.17;
			if (z > 94.0 && z < 110.0) line_ = max(line_, NycwLine(d, 0.22, fp));
			if (style == 4 && ay > 6.0 && ay < 13.5) line_ = max(line_, NycwLine(z - 128.0, 0.18, fp) + NycwLine(z - 91.0, 0.2, fp));
		}
		if (style == 6)
		{
			// denim jacket: yoke, panel seams, chest pocket flaps, tobacco stitching
			float stitch = NycwLine(z - 134.5, 0.12, fp) + NycwLine(z - 133.6, 0.1, fp) + NycwLine(abs(y) - 8.4, 0.12, fp) * step(z, 133.6)
				+ NycwLine(z - 127.4, 0.12, fp) * step(abs(abs(y) - 8.4), 3.6) + NycwLine(z - hem - 5.0, 0.12, fp) + NycwLine(abs(y) - 1.5, 0.1, fp);
			base = lerp(base, float3(0.35, 0.18, 0.05), saturate(stitch) * 0.75);
		}
		if (style == 2 || style == 7)
		{
			float beltEdge = NycwLine(abs(z - 108.0) - 2.35, 0.2, fp);
			line_ = max(line_, beltEdge);
			if (style == 2)
			{
				float dB = max(abs(y - 3.6) - 2.8, abs(z - 108.0) - 2.9);
				float buckle = NycwLine(dB, 0.45, fp);
				base = lerp(base, float3(0.045, 0.026, 0.014), buckle);
				rough = lerp(rough, 0.3, buckle);
			}
		}
		line_ *= front;
		shade *= front;
		base *= 1.0 - saturate(line_) * 0.5 - saturate(shade) * 0.28;
		height -= saturate(line_) * 0.14;
	}
	if (part == 0 || part == 1)
	{
		float z = Rest.z / s, hem = cShoe.a / s;
		float stitch = NycwLine(z - hem - 2.6, 0.13, fp) * step(abs(rn.z), 0.5);
		base *= 1.0 - stitch * 0.28;
		if (style == 3)
		{
			// stitched quilt channels, lined up with the puffs in the mesh
			float u = (Rest.z - 3.0) / (6.8 * s);
			float seam = NycwLine((u - round(u)) * 6.8 * s, 0.2, fp);
			base *= 1.0 - seam * 0.42;
			height -= seam * 0.1;
		}
		if (style == 5 && z < hem + 5.0)
		{
			float rib = sin((Rest.y + Rest.x) * 7.0) * saturate(1.5 - fp / 0.3);
			base *= 0.8 + 0.14 * rib; rough = 0.96; height += rib * 0.1;
		}
	}
	if (part == 2 && fabric == 3)
	{
		float seam = NycwLine(Rest.x + 0.5, 0.18, fp) * step(0.72, abs(rn.y));
		base = lerp(base, float3(0.3, 0.16, 0.05), seam * 0.6);
	}
	if (part == 8)
	{
		// some scarves are striped
		if (frac(seed * 13.7) > 0.68)
		{
			float stripe = NycwInside(abs(frac(Rest.z / 4.6) - 0.5) * 4.6 - 0.8, fp);
			base = lerp(base, base * 0.35 + float3(0.16, 0.15, 0.13), stripe * 0.8);
		}
	}
	if (part == 3)
	{
		float welt = NycwLine(detailMask - 1.0, 0.03, 0.03);
		base *= 1.0 - welt * 0.4;
		if (fabric == 5) { rough = 0.62; }
		else { rough = min(rough, 0.36 + 0.2 * NycwNoise(Rest * 0.9)); }
	}
	if (part == 4) { rough = 0.72; spec = 0.3; }

	// ---- faces: soft features painted at rest, nothing glassy -----------------------------------
	if (part == 12 || part == 5)
	{
		float mott = NycwNoise(Rest * 1.15) - 0.5, pore = NycwNoise(Rest * 5.0) - 0.5;
		base *= 1.0 + 0.1 * mott + near1 * 0.06 * pore;
		rough = 0.56; spec = 0.3; height = near1 * pore * 0.012; porosity = 0.2;
		if (part == 12)
		{
			float3 q = (Rest - cHead.xyz) / max(cHead.w, 0.5);
			float fpq = fp / max(cHead.w, 0.5);
			float3 tone = base;
			float faceFront = smoothstep(6.2, 7.2, q.x);
			// the cold: rosy cheeks, nose and ears
			float rose = exp(-dot(q - float3(7.0, 4.2, 6.0), q - float3(7.0, 4.2, 6.0)) * 0.16)
				+ exp(-dot(q - float3(7.0, -4.2, 6.0), q - float3(7.0, -4.2, 6.0)) * 0.16)
				+ 1.1 * exp(-dot(q - float3(10.2, 0.0, 5.8), q - float3(10.2, 0.0, 5.8)) * 0.45)
				+ 0.9 * smoothstep(6.8, 8.2, abs(q.y));
			base = lerp(base, base * float3(1.18, 0.78, 0.76), saturate(rose) * 0.55);
			float ay = abs(q.y);
			// eyes: a soft shadowed almond with a dark centre and a lash line above
			float2 e = float2((ay - 3.05) / 1.25, (q.z - 9.04) / 0.38);
			float eye = NycwInside((length(e) - 1.0) * 0.46, fpq) * faceFront;
			float3 sclera = lerp(float3(0.22, 0.18, 0.165), tone, 0.45);
			base = lerp(base, sclera, eye);
			float iris = NycwInside(length(float2(ay - 2.98, (q.z - 9.06) * 1.08)) - 0.52, fpq) * eye;
			base = lerp(base, float3(0.022, 0.013, 0.008) + cHair.rgb * 0.12, iris);
			float lid = NycwLine(q.z - 9.41 + 0.15 * pow((ay - 3.05) / 1.3, 2.0), 0.15, fpq) * step(abs(ay - 3.05), 1.45) * faceFront;
			base = lerp(base, tone * 0.3, lid);
			base *= 1.0 - 0.16 * exp(-pow((ay - 3.05) / 1.9, 2.0) - pow((q.z - 9.35) / 1.15, 2.0)) * faceFront;
			// brows
			float browZ = 11.05 + 0.34 * sin(saturate((ay - 1.0) / 4.0) * 2.4) - 0.2;
			float brow = NycwLine(q.z - browZ, 0.3 - 0.1 * female, fpq) * smoothstep(0.85, 1.5, ay) * smoothstep(4.9, 3.9, ay) * faceFront;
			float3 browCol = lerp(cHair.rgb * 0.8, tone * 0.35, 0.3);
			base = lerp(base, browCol, brow * (0.55 + 0.4 * NycwNoise(Rest * 7.0)));
			// lips and the line between them
			float lips = NycwInside((length(float2(q.y / 2.2, (q.z - 2.78) / (0.78 + 0.1 * female))) - 1.0) * 0.8, fpq) * faceFront;
			base = lerp(base, tone * lerp(float3(0.92, 0.66, 0.65), float3(0.98, 0.52, 0.53), female * step(0.5, frac(seed * 3.9))), lips * 0.78);
			rough = lerp(rough, 0.42, lips);
			float mouth = NycwLine(q.z - 2.76 - 0.07 * cos(q.y * 1.4), 0.08, fpq) * smoothstep(2.15, 1.5, ay) * faceFront;
			base = lerp(base, tone * float3(0.55, 0.42, 0.4), mouth * 0.9);
			float nostril = NycwInside(length(float2(ay - 0.78, (q.z - 4.72) * 1.7)) - 0.45, fpq) * step(8.4, q.x);
			base = lerp(base, tone * 0.28, nostril * 0.8);
			// stubble on some men
			if (female < 0.5 && frac(seed * 5.17) > 0.52)
			{
				float jaw = smoothstep(5.4, 3.8, q.z) * smoothstep(-0.5, 3.0, q.x) * smoothstep(-3.2, -0.6, q.z) * (1.0 - lips);
				jaw = max(jaw, NycwLine(q.z - 3.9, 0.38, fpq) * smoothstep(2.4, 1.6, ay) * faceFront);
				base = lerp(base, lerp(base, cHair.rgb, 0.72), jaw * (0.35 + 0.45 * NycwNoise(Rest * 6.0)));
				rough = lerp(rough, 0.8, jaw);
			}
		}
	}
	if (part == 6)
	{
		float strand = NycwNoise(Rest * float3(3.4, 3.4, 0.55)) - 0.5;
		float lock_ = NycwNoise(Rest * float3(0.9, 0.9, 0.28)) - 0.5;
		base *= 1.0 + near2 * (0.7 * strand + 0.35 * lock_);
		rough = 0.58; spec = 0.3; height = near2 * (strand * 0.09 + lock_ * 0.14); porosity = 0.3; fuzz = 0.25;
	}

	// ---- props ----------------------------------------------------------------------------------
	if (part == 15)
	{
		if (fabric == 6)
		{
			base = cUmb.rgb;
			rough = 0.44; spec = 0.4;
			// eight panels: a stitched seam over every rib, and each panel catches the light a little differently
			float panel = atan2(Rest.y, Rest.x) / 0.7853981;
			float seam = NycwLine((panel - round(panel)) * 0.7853981 * length(Rest.xy), 0.22, fp);
			base *= (1.0 - 0.45 * seam) * (0.9 + 0.2 * NycwHash(float3(floor(panel), seed * 91.0, 2.0)));
			height -= 0.22 * seam;
			height += (NycwNoise(Rest * 0.45) - 0.5) * 0.22 * near2;
			base += graze * (base * 0.6 + 0.004);
			// the underside is shaded cloth
			if (rn.z < -0.2) base *= 0.75;
		}
		else if (fabric == 9) { base = float3(0.025, 0.025, 0.028); }
		else if (fabric == 2) { base = cBag.rgb; }
		else if (fabric == 5) { base = frac(seed * 9.1) < 0.5 ? float3(0.30, 0.19, 0.095) : cBag.rgb * 1.4 + 0.02; if (Rest.z < 5.0 && Rest.z > -3.0 && length(Rest.xy - float2(0.6, 0.0)) < 4.2) base = float3(0.14, 0.07, 0.03); }
		else if (fabric == 8)
		{
			if (detailMask > 0.2 && detailMask < 0.8)
			{
				// a lit phone screen
				float bands = 0.65 + 0.35 * step(0.5, frac(Rest.x * 0.55)) * step(abs(Rest.y), 2.7);
				base = float3(0.01, 0.01, 0.012);
				Emissive = float3(0.55, 0.66, 0.9) * bands * lerp(260.0, 55.0, Night);
				rough = 0.12; spec = 0.5;
			}
			else base = float3(0.66, 0.65, 0.62);
		}
	}

	// ---- cloth fuzz, wet, snow ------------------------------------------------------------------
	base += fuzz * graze * (base * 0.9 + 0.006);
	base *= lerp(1.0, 0.74 + 0.26 * AO, 0.8);

	// under an umbrella people stay mostly dry
	float exposed = 1.0 - 0.8 * cCoat.a * step(100.0, Rest.z / s);
	float wet = Wetness * saturate(Rain * 2.2) * saturate(0.45 + rn.z * 0.8 + 0.35 * NycwNoise(Rest * 0.14)) * exposed;
	if (part == 15 && fabric == 6) wet = saturate(Rain * 2.5);
	base *= lerp(1.0, 0.62, wet * porosity);
	rough = lerp(rough, min(rough, 0.22), wet * (1.0 - porosity * 0.75));
	spec = lerp(spec, 0.5, wet);
	if (part == 15 && fabric == 6 && wet > 0.05)
	{
		float bead = smoothstep(0.78, 0.9, NycwNoise(Rest * 1.6)) * near2;
		height += bead * 0.16 * wet;
		rough = lerp(rough, 0.08, bead);
	}
	// falling snow settles on hats, shoulders and umbrellas
	float settle = SnowFall * smoothstep(0.55, 0.9, N.z) * exposed;
	if (part == 15 && fabric == 6) settle = SnowFall * smoothstep(0.55, 0.9, N.z);
	if (settle > 0.01 && part != 12 && part != 5)
	{
		float flakes = smoothstep(0.80 - 0.34 * settle, 0.94 - 0.2 * settle, NycwNoise(Rest * 1.45) * 0.7 + NycwNoise(Rest * 4.1) * 0.3);
		base = lerp(base, float3(0.78, 0.81, 0.87), flakes * saturate(settle * 1.6));
		rough = lerp(rough, 0.55, flakes);
	}

	// ---- bump from the procedural height (surface gradient) ------------------------------------
	float dhx = ddx(height), dhy = ddy(height);
	float3 r1 = cross(dpdy, N), r2 = cross(N, dpdx);
	float det = dot(dpdx, r1);
	float3 grad = sign(det) * (dhx * r1 + dhy * r2);
	Normal = abs(det) > 1e-7 ? normalize(abs(det) * N - grad * bump) : N;

	Roughness = saturate(rough);
	Specular = spec;
	Metallic = metal;
	return saturate(base);
}

// dithered fade: 1 keeps the pixel
float NycWalkerFade(float Fade, float2 PixelPos, float Frame)
{
	if (Fade >= 0.999) return 1.0;
	float2 p = PixelPos + Frame * float2(47.0, 17.0);
	float n = frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
	return Fade > n ? 1.0 : 0.0;
}
